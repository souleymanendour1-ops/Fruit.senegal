# Exemple de variables d'environnement.
# En local, rien n'est obligatoire (l'app utilise un fichier JSON).
# En ligne (hébergement), définissez ces variables sur la plateforme.

# Mot de passe de l'espace administrateur (À CHANGER absolument en production)
ADMIN_PASSWORD=changez_moi

# Port d'écoute (souvent fourni automatiquement par l'hébergeur)
PORT=3000

# Connexion PostgreSQL. Si cette variable est définie, l'app conserve les
# données dans Postgres (persistant) au lieu du fichier local.
# Exemple : postgres://utilisateur:motdepasse@hote:5432/nom_base
# DATABASE_URL=
